# --- TESTFORGE configuration -------------------------------------------------
# Copy this file to ".env" and fill in the keys you have.
# Only the provider you actually use needs a key.

# DeepSeek (default provider for this project). https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# OpenAI (optional comparison arm). https://platform.openai.com/
OPENAI_API_KEY=

# Generic key used by the "custom" provider (your SWT-Bench scaffold, vLLM, etc.)
CUSTOM_API_KEY=

# Optional: raises GitHub archive download rate limits for public repos.
GITHUB_TOKEN=
